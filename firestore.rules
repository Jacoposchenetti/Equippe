rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function isAdmin() { return isAuthenticated() && request.auth.token.email in ['admin@tuaequipe.it', 'jschenetti@gmail.com', 'udemyteam2025@gmail.com', 'martinamaccara@icloud.com', 'martinamaccarana@icloud.com']; }

    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
      match /fatturazione_config/{docId} { allow read, write: if isOwner(userId); }
      match /clienti/{clienteId} { allow read, write: if isOwner(userId); }
      match /fatture/{fatturaId} { allow read, write: if isOwner(userId); }
      match /integrations/{integId} { allow read, write: if isOwner(userId); }
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.adminUid == request.auth.uid;
    }

    match /referrals/{refId} {
      allow read: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
    }

    match /conversations/{convId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      match /messages/{msgId} { allow read, write: if isAuthenticated(); }
    }

    match /messages/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    match /teamInvites/{inviteId} {
      allow read: if isAuthenticated() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
    }

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    match /marketplace_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    match /marketplace_offers/{offerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.creatorUid == request.auth.uid;
    }

    match /ecm_events/{eventId} { allow read: if isAuthenticated(); }
    match /ecmEvents/{eventId} { allow read: if isAuthenticated(); }
    match /ecm_sync_state/{docId} { allow read: if isAuthenticated(); }
    match /ecmSyncStatus/{docId} { allow read: if isAuthenticated(); }

    match /availability/{uid} {
      allow read: if true;
      // Admin può fare tutto
      allow write: if isAdmin();
      // Il professionista può creare il proprio doc, ma isPublic deve essere false
      allow create: if isOwner(uid) && request.resource.data.isPublic == false;
      // Il professionista può aggiornare il proprio doc, ma non può cambiare isPublic
      allow update: if isOwner(uid) && request.resource.data.isPublic == resource.data.isPublic;
    }

    match /appointments/{appointmentId} {
      allow create: if true;
      allow read: if isAuthenticated() && (resource.data.professionalUid == request.auth.uid || resource.data.patientEmail == request.auth.token.email);
      allow update: if isAuthenticated() && (resource.data.professionalUid == request.auth.uid || resource.data.patientEmail == request.auth.token.email);
    }

    match /patients/{patientId} { allow read, write: if isOwner(patientId); }

    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /waitlist/{docId} {
      allow create: if true;
      allow read: if isAuthenticated();
    }
  }
}
