{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test:analytics": "npm run build && node test_analytics.cjs",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cheerio": "^1.0.0",
    "equippe-mvp": "file:..",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "googleapis": "^171.4.0",
    "pdfkit": "^0.15.0",
    "resend": "^6.8.0",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.10.6",
    "@types/pdfkit": "^0.13.5",
    "typescript": "^5.3.3"
  },
  "private": true
}
